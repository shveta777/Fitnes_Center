<Window x:Class="FitnessCenterApp.Views.EditDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование записи"
        Width="650" Height="760"
        MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#CFEAF6">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Добавление записи"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Grid x:Name="FieldsGrid"
              Grid.Row="1"
              Width="560"
              HorizontalAlignment="Center"/>

        <Button Grid.Row="2"
                Content="Сохранить"
                Style="{StaticResource RoundedButton}"
                Width="190"
                Height="44"
                HorizontalAlignment="Center"
                Margin="0,18,0,0"
                Click="BtnSave_Click"/>
    </Grid>
</Window>
