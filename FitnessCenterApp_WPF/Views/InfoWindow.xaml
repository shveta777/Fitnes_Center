<Window x:Class="FitnessCenterApp.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Caption}"
        Width="560" Height="420"
        MinWidth="560" MinHeight="420"
        MaxWidth="620" MaxHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Border Margin="18" Background="White" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F8EBEE" CornerRadius="18,18,0,0">
                <StackPanel Orientation="Horizontal" Margin="28,0">
                    <Border Width="58" Height="58" CornerRadius="29"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding Header}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Width="450"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding Details}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       LineHeight="27"
                       Margin="42,28,42,10"
                       VerticalAlignment="Top"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="BtnYes"
                        Content="{Binding ConfirmText}"
                        Style="{StaticResource RoundedButton}"
                        Width="150"
                        Height="42"
                        Margin="0,0,16,0"
                        Click="BtnYes_Click"/>

                <Button Content="{Binding CancelText}"
                        Style="{StaticResource RoundedButton}"
                        Width="150"
                        Height="42"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
