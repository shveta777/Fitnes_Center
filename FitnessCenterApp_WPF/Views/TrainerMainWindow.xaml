<Window x:Class="FitnessCenterApp.Views.TrainerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренер — FitnessCenter"
        Width="1150" Height="720"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="▣  FitnessCenter" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="🏋  Тренер" FontSize="15" Margin="0,14,0,26"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <Button Content="📅  Расписание" Style="{StaticResource MenuButton}" Click="BtnSchedule_Click"/>
                    <Button Content="🕘  График работы" Style="{StaticResource MenuButton}" Click="BtnAvailability_Click"/>
                    <Button Content="👥  Клиенты" Style="{StaticResource MenuButton}" Click="BtnClients_Click"/>
                    <Button Content="📊  Статистика" Style="{StaticResource MenuButton}" Click="BtnStats_Click"/>
                </StackPanel>

                <Button Grid.Row="2" Content="🚪  Выйти из системы"
                        Style="{StaticResource MenuButton}" Height="34" Margin="0" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitle" Text="📅  Расписание"
                       FontSize="32" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Border Grid.Row="1" Background="White" Padding="8">
                <DockPanel>
                    <Button x:Name="BtnAdd" Content="Добавить"
                            Style="{StaticResource RoundedButton}"
                            Width="150" Height="36"
                            DockPanel.Dock="Left"
                            Click="BtnAdd_Click"/>
                    <TextBox x:Name="TxtSearch" Style="{StaticResource InputBox}"
                             Width="240" HorizontalAlignment="Right"
                             DockPanel.Dock="Right"
                             TextChanged="TxtSearch_TextChanged"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentStack" Margin="0,14,0,0"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
